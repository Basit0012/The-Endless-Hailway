  clueId: Clue_IncidentReport1
  title: TORN INCIDENT REPORT #0414
  documentText: 'A charred fragment of an official incident report.


    DATE: OCT
    14, 1978

    UNIT: 214

    TENANT: ELIAS VOSS


    ''During routine inspection,
    smoke damper failed to open. Tenant attempted repeated contact with Resident
    Manager Aiden...


    [The paper feels unnervingly warm to the touch, as though
    pulled from recent embers.]'''
  documentSprite: {fileID: 21300000, guid: 8f89aba35c63d3842983714f35968572, type: 3}
  warmToTouch: 1
  promptText: '[E] Pick up scorched paper'

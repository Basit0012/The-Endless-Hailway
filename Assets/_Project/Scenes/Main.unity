  m_Script: {fileID: 11500000, guid: c9fcb33c39b62a24f8c3d0833bef44a5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EndlessHallway.Interaction.Examinable
  clueId: Clue_Newspaper
  title: THE MARROW COURIER - OCT 1978
  documentText: 'THE MARROW COURIER - OCTOBER 12, 1978


    ''TENANT PETITION DEMANDS
    ELEVATOR & ALARM OVERHAUL''


    Residents across floors 2 and 3 have formally
    submitted grievances regarding the erratic elevator descent patterns and fire
    alarm testing scheduled late past midnight.


    Superintendent Vance commented:
    ''All automated protocols are designed for resident security during smoke damper
    maintenance.'''
  documentSprite: {fileID: 21300000, guid: f4740fa3a69acf74e85738056a1509a6, type: 3}
  warmToTouch: 0
  promptText: '[E] Read Newspaper'
